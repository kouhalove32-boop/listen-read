{
  "name": "listen-read",
  "productName": "ListenRead",
  "version": "1.0.0",
  "description": "TOEIC listen & read player",
  "author": "kouhalove32-boop",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "io.github.kouhalove32.listenread",
    "productName": "ListenRead",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "assets/**"
    ],
    "extraResources": [
      {
        "from": "web",
        "to": "web"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "web/icon-512.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "ListenRead-Setup-${version}.exe",
      "shortcutName": "聞き読みプレーヤー",
      "uninstallDisplayName": "聞き読みプレーヤー"
    }
  }
}